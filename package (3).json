{
  "name": "crm-sender",
  "version": "17.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:entry": "node scripts/embed-advance-entry.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:balance": "node tests/balance-browser.cjs",
    "build:security": "node scripts/embed-security.cjs",
    "build": "npm run build:entry && npm run build:security && npm run build:statements",
    "test:security": "node --test tests/security.test.cjs",
    "test:security:browser": "SECURITY_BROWSER=1 node --test tests/security-api.test.cjs",
    "test:postgres": "node tests/security-postgres.cjs",
    "build:statements": "node scripts/embed-statements.cjs",
    "test:statements:browser": "node tests/statements-v17-browser.cjs"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "nodemailer": "10.3.0",
    "pdfmake": "0.2.23"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
